# Copy this file to .env for local development.
# NEVER commit .env to source control.

# === For Local Dev (SSO) ===
# Leave PASSWORD blank. First API call will open your browser to authenticate.
# Credentials are cached in ~/.snowflake/

SNOWFLAKE_ACCOUNT=connectwise_ent.us-east-1
SNOWFLAKE_USER=nate.fold@connectwise.com
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=externalbrowser

SNOWFLAKE_WAREHOUSE=CORTEX_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=DBO
SNOWFLAKE_ROLE=DEVELOPER

# === For SPCS Deployment ===
# Set PASSWORD to service account password if deploying to container.
# These values are overridden by Snowflake Secrets in SPCS anyway.
